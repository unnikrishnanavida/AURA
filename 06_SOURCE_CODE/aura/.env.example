# AURA environment reference
# Copy to .env (never committed) and adjust per environment.

# Runtime environment: development | testing | research | staging | production
AURA_ENVIRONMENT=development

# Instance id guards cross-instance state collisions
AURA_INSTANCE_ID=default

# Optional provider API key (shows as SecretStr; auto-redacted in dumps/logs)
AURA_PROVIDER_API_KEY=

# Budgets
AURA_MAX_ACTIONS=50
AURA_MAX_SECONDS=120
AURA_MAX_COST=10
AURA_MAX_TOKENS=200000

# Engine toggles (1=on, 0=off)
AURA_MEMORY_ENABLED=1
AURA_KNOWLEDGE_ENABLED=1
AURA_REASONING_ENABLED=1
AURA_PLANNING_ENABLED=1
AURA_REFLECTION_ENABLED=1
AURA_LEARNING_ENABLED=1
AURA_REASONING_SEED=

# Logging
AURA_LOG_LEVEL=INFO
AURA_LOG_JSON=1
AURA_LOG_REDACT_SECRETS=1

# Storage (persistence)
#   memory (default; lost on restart) | sqlite (file-backed) | postgresql (interface-only)
# Production REQUIRES a persistent backend; the config validator refuses
# backend=memory when AURA_ENVIRONMENT=production.
AURA_STORAGE_BACKEND=memory
# SQLite database file (relative to the working directory of the process)
AURA_STORAGE_SQLITE_PATH=data/aura.sqlite3
# Run forward migrations at startup (1=yes, 0=no)
AURA_STORAGE_RUN_MIGRATIONS=1
# Run an integrity quick check on open (1=yes, 0=no)
AURA_STORAGE_INTEGRITY_CHECK_ON_OPEN=1

# API
AURA_API_HOST=127.0.0.1
AURA_API_PORT=8765