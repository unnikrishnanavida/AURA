# AURA environment reference
# Copy to .env (never committed) and adjust per environment.

# Runtime environment: development | testing | research | staging | production
AURA_ENVIRONMENT=development

# Instance id guards cross-instance state collisions
AURA_INSTANCE_ID=default

# Optional provider API key (shows as SecretStr; auto-redacted in dumps/logs)
AURA_PROVIDER_API_KEY=

# Budgets
AURA_MAX_ACTIONS=50
AURA_MAX_SECONDS=120
AURA_MAX_COST=10
AURA_MAX_TOKENS=200000

# Engine toggles (1=on, 0=off)
AURA_MEMORY_ENABLED=1
AURA_KNOWLEDGE_ENABLED=1
AURA_REASONING_ENABLED=1
AURA_PLANNING_ENABLED=1
AURA_REFLECTION_ENABLED=1
AURA_LEARNING_ENABLED=1
AURA_REASONING_SEED=

# Logging
AURA_LOG_LEVEL=INFO
AURA_LOG_JSON=1
AURA_LOG_REDACT_SECRETS=1

# API
AURA_API_HOST=127.0.0.1
AURA_API_PORT=8765